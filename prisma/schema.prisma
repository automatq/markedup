generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  /// Clerk organization ID — null for personal workspaces
  orgId     String?
  /// Clerk user ID of the workspace owner
  ownerId   String
  /// True = private to the owner, not visible to org members
  isPersonal Boolean   @default(false)
  /// Auto-save agent breakout files to this workspace
  autoBreakouts Boolean @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents  Document[]
  invites    Invite[]
  callLogs   CallLog[]
  agentRoles AgentConfig[]

  @@index([slug])
  @@index([orgId])
  @@index([ownerId])
}

model Document {
  id          String    @id @default(cuid())
  title       String    @default("Untitled")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Clerk user ID of who created this document
  createdBy   String?

  /// Self-relation for nested pages / folders
  parentId    String?
  parent      Document?  @relation("DocumentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Document[] @relation("DocumentChildren")

  /// TipTap JSONContent stored as JSON
  content Json?

  /// Yjs document state as a binary blob (reserved for future collab)
  yjsState Bytes?

  /// Origin type: "spreadsheet", "markerboard", or null for regular docs
  sourceType String?

  /// Clerk user ID of who deleted this document
  deletedBy  String?

  /// Soft-delete timestamp — null means not deleted
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backlink graph edges
  outgoingLinks Node[]      @relation("SourceDocument")
  incomingLinks Node[]      @relation("TargetDocument")
  shareLinks    ShareLink[]
  breakouts     Breakout[]
  views         DocumentView[]
  agentTraining AgentTrainingDoc[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, updatedAt])
  @@index([parentId])
  @@index([createdBy])
}

model Node {
  id String @id @default(cuid())

  sourceDocumentId String
  sourceDocument   Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  targetDocumentId String
  targetDocument   Document @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)

  linkText  String
  createdAt DateTime @default(now())

  @@unique([sourceDocumentId, targetDocumentId, linkText])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
}

/// AI agent breakout files — role-specific action plans generated from a document
model Breakout {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Agent role ID (ceo, cro, cto)
  agentId    String
  /// Agent display name at time of generation
  agentName  String
  /// The generated markdown content
  content    String
  /// Clerk user ID of who generated it
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
  @@index([documentId, agentId])
  @@index([createdBy])
}

/// Invite codes for joining a company workspace
model Invite {
  id          String    @id @default(cuid())
  /// Short code users type to join (e.g. "acme-7x3k")
  code        String    @unique
  /// The workspace this invite grants access to
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Clerk org ID to add the user to
  orgId       String
  /// Who created the invite
  createdBy   String
  /// How many times this code can be used (null = unlimited)
  maxUses     Int?
  /// How many times it has been used
  uses        Int       @default(0)
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([code])
  @@index([workspaceId])
}

/// Call logs with audio transcription and AI analysis
model CallLog {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Call title / contact name
  title         String
  /// Raw transcript from Whisper
  transcript    String
  /// AI-generated call summary (markdown)
  summary       String?
  /// AI-extracted action items (markdown)
  actionItems   String?
  /// Call outcome: "positive" | "neutral" | "negative"
  outcome       String?
  /// Success score 0-100
  score         Int?
  /// Call duration in seconds
  durationSecs  Int?
  /// Who uploaded / recorded
  createdBy     String
  /// Optional: linked document ID where the call notes were saved
  documentId    String?
  /// Tags for filtering (comma-separated)
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([createdBy])
}

/// Custom AI agent roles created by a workspace/group
model AgentConfig {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Short identifier (e.g. "ceo", "sales-lead")
  roleId      String
  /// Display name (e.g. "Dylan")
  name        String
  /// Title (e.g. "CEO", "Head of Sales")
  title       String
  /// Hex color for UI
  color       String    @default("#6366f1")
  /// Single character avatar
  avatar      String    @default("A")
  /// What this agent focuses on
  description String
  /// System prompt for AI interactions
  systemPrompt String
  /// Who created this agent
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trainingDocs AgentTrainingDoc[]
  assignments  RoleAssignment[]

  @@unique([workspaceId, roleId])
  @@index([workspaceId])
}

/// Links documents as training material for an AI agent
model AgentTrainingDoc {
  id        String      @id @default(cuid())
  agentId   String
  agent     AgentConfig @relation(fields: [agentId], references: [id], onDelete: Cascade)
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addedBy   String
  addedAt   DateTime    @default(now())

  @@unique([agentId, documentId])
  @@index([agentId])
  @@index([documentId])
}

/// Agent-generated insight reports (signal/noise, vision tracking, workflow logs)
model AgentReport {
  id          String   @id @default(cuid())
  workspaceId String
  /// Which agent config generated this (nullable for system-level reports)
  agentId     String?
  /// Report type: "signal_noise" | "vision_tracker" | "workflow_log" | "digest"
  type        String
  /// JSON payload — structure varies by type
  payload     Json
  /// Who triggered the generation (or "system" for auto)
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
}

/// Workspace integrations (GitHub repos, etc.)
model WorkspaceIntegration {
  id          String   @id @default(cuid())
  workspaceId String
  /// Integration type: "github"
  type        String
  /// Unique name within type — e.g. "owner/repo" for GitHub
  name        String   @default("")
  /// JSON config — e.g. { owner, repo, token? }
  config      Json
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, type, name])
  @@index([workspaceId])
}

/// Weekly KPI targets and actuals per team member
model Kpi {
  id          String   @id @default(cuid())
  workspaceId String
  /// Clerk user ID of the team member this KPI belongs to
  userId      String
  /// KPI name (e.g. "Docs Created", "Calls Made", "Revenue Closed")
  name        String
  /// Target value for the week
  target      Float
  /// Actual value (updated as the week progresses)
  actual      Float    @default(0)
  /// Unit label (e.g. "docs", "calls", "$", "%")
  unit        String   @default("")
  /// ISO week string (e.g. "2026-W11")
  week        String
  /// Category for grouping: "output" | "quality" | "growth" | "custom"
  category    String   @default("custom")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, userId, name, week])
  @@index([workspaceId, week])
  @@index([workspaceId, userId])
}

/// Per-workspace agent monitoring toggle + config
model AgentMonitor {
  id          String   @id @default(cuid())
  workspaceId String
  /// Which agent config is monitoring
  agentConfigId String
  /// Whether this agent is actively monitoring
  enabled     Boolean  @default(false)
  /// What to monitor: JSON array e.g. ["docs","calls","github","kpis"]
  watchList   Json     @default("[]")
  /// How often to auto-report: "daily" | "weekly" | "realtime"
  frequency   String   @default("weekly")
  /// Last time the agent ran an auto-analysis
  lastRunAt   DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, agentConfigId])
  @@index([workspaceId])
}

/// Track who viewed a document and when
model DocumentView {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  viewedAt   DateTime @default(now())

  @@unique([documentId, userId])
  @@index([documentId])
}

/// Public/private share links for documents
model ShareLink {
  id         String   @id @default(cuid())
  /// Short token for the URL (e.g. /share/abc123)
  token      String   @unique @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Who created the link
  createdBy  String
  /// "view" or "edit"
  permission String   @default("view")
  /// Whether the link is active
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  expiresAt  DateTime?

  @@index([token])
  @@index([documentId])
}

/// Maps team members to agent roles (e.g. Chris = CTO, Dylan = CEO)
model RoleAssignment {
  id            String      @id @default(cuid())
  workspaceId   String
  /// Clerk user ID of the team member
  userId        String
  /// Which agent role this member holds
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  /// Who made the assignment
  assignedBy    String
  createdAt     DateTime    @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([agentConfigId])
}

/// AI-generated business operations timeline — daily, weekly, monthly summaries
model OperationsDigest {
  id          String   @id @default(cuid())
  workspaceId String
  /// "daily" | "weekly" | "monthly"
  period      String
  /// Start of the period (inclusive)
  periodStart DateTime
  /// End of the period (exclusive)
  periodEnd   DateTime
  /// AI-generated narrative summary (markdown)
  summary     String
  /// Structured metrics snapshot for the period
  metrics     Json
  /// Key highlights / milestones
  highlights  Json     @default("[]")
  /// Document IDs referenced in this digest
  docRefs     Json     @default("[]")
  /// Full AI response payload
  payload     Json
  /// Who triggered generation (or "system" for cron)
  createdBy   String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, period, periodStart])
  @@index([workspaceId, period])
  @@index([workspaceId, periodStart])
}
